# ===== QuantMark - Producción (Cloud Run) =====
ENVIRONMENT=production
PORT=8080
LOG_LEVEL=info

# PostgreSQL (Cloud SQL / Neon / Supabase)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/quantmark
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Seguridad
SECRET_KEY=generate-a-64-char-random-key-here

# Storage de certificados (gcs | s3 | local)
STORAGE_BACKEND=gcs
GCS_BUCKET=quantmark-certificates

# CORS - dominios permitidos (separados por coma)
CORS_ORIGINS=https://quantmark.web.app,https://quantmark.firebaseapp.com,https://quantmark-api-xxx-uc.a.run.app
