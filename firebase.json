{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "quantmark-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/docs",
        "run": {
          "serviceId": "quantmark-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/openapi.json",
        "run": {
          "serviceId": "quantmark-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/redoc",
        "run": {
          "serviceId": "quantmark-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "quantmark-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
